APP_NAME="VJU CMS"
APP_ENV=testing
APP_KEY=base64:xknCKeIwQFd6x7vwVzqUAiup21utOFbPQhfVYB0SS1o=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=vi
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Integration tests run on a dedicated MySQL 8 database, never SQLite.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vju_cms_test
DB_USERNAME=vju_test
DB_PASSWORD=secret

# The DatabaseSource tests read WordPress fixture tables (prefix wptest_) from the test database.
WP_DB_HOST=mysql
WP_DB_DATABASE=vju_cms_test
WP_DB_USERNAME=vju_test
WP_DB_PASSWORD=secret
WP_DB_PREFIX=wptest_
WP_BASE_URL=https://vju.ac.vn

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
REDIS_CLIENT=phpredis
REDIS_HOST=redis
MEDIA_DISK=public
CMS_PASSWORD_LOGIN=true
GOOGLE_CLIENT_ID=test-client
GOOGLE_CLIENT_SECRET=test-secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=vju.ac.vn
GOOGLE_AUTO_PROVISION=true
BCRYPT_ROUNDS=4
